// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "wsl_connections": [
    {
      "distro_name": "Ubuntu",
      "user": null,
      "projects": []
    }
  ],
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": false,
  "agent_servers": {
    "opencode-v2": {
      "default_config_options": {
        "mode": "plan",
        "model": "opencode/deepseek-v4.1-flash-free"
      },
      "favorite_config_option_values": {
        "model": [
          "opencode/deepseek-v4.1-flash-free"
        ]
      },
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    // "font_family": "FiraCode Nerd Font",
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  // "buffer_font_family": "FiraCode Nerd Font",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "JetBrains Dark",
  },
  "wrap_guides": [80, 120],
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "languages": {
    "Python": {
      "language_servers": ["ruff", "ty", "!basedpyright"],
      "format_on_save": "on",
      "formatter": "language_server",
    },
    "TypeScript": {
      "language_servers": ["tsgo", "typescript-language-server"],
      "format_on_save": "on",
    },
    "TSX": {
      "language_servers": ["typescript-language-server"],
    },
    "Go": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
  },
  "auto_install_extensions": {
    "csv": true,
    "dockerfile": true,
    "emmet": true,
    "env": true,
    "git-firefly": true,
    "html": true,
    "ini": true,
    "java": true,
    "jetbrains-themes": true,
    "log": true,
    "make": true,
    "proto": true,
    "python-requirements": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "tsgo": true,
    "xml": true,
  },
}
